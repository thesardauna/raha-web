NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From https://dashboard.postcode.gov.ng (Settings -> API Keys). Server-side only.
# nipost_test_... = free sandbox (resolves only a small sample of public places)
# nipost_live_... = production (needs verified KYB)
POSTCODE_API_KEY=nipost_test_...
POSTCODE_MAX_LEVEL=1

# Shown to customers at checkout (manual bank transfer)
NEXT_PUBLIC_BANK_NAME=Your bank
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Your account name
